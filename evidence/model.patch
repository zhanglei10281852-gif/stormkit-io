+		VALUES ($1, 'upload', 'pending', 'orphan.txt', 6, $2, $3, $4)
+	`,
+		env.ID, volumes.FileSys,
+		fmt.Sprintf(`{"path": "%s", "name": "orphan.txt"}`, orphanDir),
+		time.Now().Add(-time.Hour),
