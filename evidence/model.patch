+func (s *JobVolumesSuite) countOps(envID types.ID) int {
+	var count int
+
+	s.NoError(s.conn.
+		QueryRow("SELECT COUNT(*) FROM volumes_ops WHERE env_id = $1", envID).
+		Scan(&count),
+	)
+
+	return count
+}
